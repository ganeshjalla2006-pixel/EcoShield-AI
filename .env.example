# =================================================================
# EcoShield AI — Environment Configuration Template
# =================================================================
# Initial Budget Constraint: ₹0 (Zero Paid Dependencies Required)
# EcoShield AI operates completely out of the box with zero external
# credentials using Open-Meteo Open Data API and OpenStreetMap tiles.
# =================================================================

# Weather & Air Quality Providers (Open-Meteo — No key required for non-commercial open data)
# Open-Meteo terms: https://open-meteo.com/en/terms
# Attribution: Weather & Air Quality by Open-Meteo.com under CC BY 4.0 (Copernicus CAMS)
VITE_WEATHER_API_ENDPOINT=https://api.open-meteo.com/v1/forecast
VITE_AIR_QUALITY_API_ENDPOINT=https://air-quality-api.open-meteo.com/v1/air-quality

# Mapping Provider (Leaflet + OpenStreetMap)
# Attribution: © OpenStreetMap contributors
# Tile Policy: https://operations.osmfoundation.org/policies/tiles/

# Supabase PostgreSQL & Auth Backend (Project ID: crkdgimdrhiopzkbjqbg)
# When provided, enables real email/password authentication, PostgreSQL RLS, and Cloud Storage.
# Copy your Project URL and anon key from Supabase Dashboard -> Project Settings -> API.
# Note: Initial Admin (Ganesh Reddy: ganeshjalla2006@gmail.com) is provisioned via database SQL.
# Never place service_role private master secret keys here!
VITE_SUPABASE_URL=https://crkdgimdrhiopzkbjqbg.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Optional: Firebase Authentication & Cloud Firestore (Spark Free Tier)
# Leave blank to run on the built-in browser persistent storage engine.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Government / Institutional Environmental Portals (When API Keys are Issued)
VITE_CPCB_API_KEY=
VITE_OPENAQ_API_KEY=
