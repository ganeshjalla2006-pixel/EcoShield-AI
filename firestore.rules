rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isFieldWorker() {
      return isAuthenticated() && (getUserRole() == 'field_worker' || getUserRole() == 'admin');
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only the user themselves can edit their display name; role cannot be altered by client
      allow update: if isAuthenticated() && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isDeactivated']);
      // Role elevation requires Admin
      allow write: if isAdmin();
    }

    // Pollution Reports
    match /reports/{reportId} {
      // Anyone can read verified or active public reports
      allow read: if true;
      // Authenticated users can submit a report
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      // Only Field Workers & Admins can verify or update status
      allow update: if isFieldWorker() || (isAuthenticated() && resource.data.reporterId == request.auth.uid && resource.data.status == 'submitted');
      allow delete: if isAdmin();
    }

    // Prevention Tasks
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      // Only Field Workers or Admins can create or update prevention tasks
      allow create, update: if isFieldWorker();
      allow delete: if isAdmin();
    }

    // Environmental Hotspots
    match /hotspots/{hotspotId} {
      allow read: if true;
      allow write: if isAdmin() || isFieldWorker();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == null);
      allow create: if isFieldWorker();
    }

    // Audit Logs (Immutable append-only)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }
  }
}
